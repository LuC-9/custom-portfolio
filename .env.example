# APP_URL: The URL where this applet is hosted.
# Optional for the active app routes; useful for hosting/platform metadata.
APP_URL="MY_APP_URL"

# Telegram contact delivery. Required for /api/contact and the chatbot
# guided contact flow to send messages.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"
# Optional AI: create a key at https://console.groq.com/keys on the Free Plan.
# Server-only. Never prefix this key with NEXT_PUBLIC_. Leave blank for search fallback.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
